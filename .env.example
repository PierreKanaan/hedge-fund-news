# Groq (free): https://console.groq.com -> API Keys
GROQ_API_KEY=

# Finnhub (free): https://finnhub.io/register -> Dashboard shows your API key
FINNHUB_API_KEY=

# Gmail App Password (NOT your normal password):
# https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Comma-separated list of who receives the digest email
EMAIL_RECIPIENTS=teammate1@example.com,teammate2@example.com
